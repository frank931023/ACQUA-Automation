# Python 快取檔與編譯檔
__pycache__/
*.pyc
*.pyo
*.pyd

# 虛擬環境
.venv/
venv/
ENV/

# 敏感設定檔（只留 config.example.json）
config.json

# IDE 與編輯器設定（視情況加入）
.vscode/
.idea/

# 作業系統產生的雜檔
.DS_Store
Thumbs.db

# 產出檔(報告、匯出)—— 不進版控
reports/
*.doc
*.docx
*.csv

# 暫存
*.tmp
*.bak

# 機器專屬設定(含密碼)—— 不進版控,見 .env.example
.env

# 執行紀錄
logs/

# ⚠️ setups/ 與 plans/ 刻意**不**列在這裡。
# 它們看起來像執行期資料,其實是對過現場才調出來的數字(擺位是 19 根軸的
# 位置,測試計畫是一整批測項)。刪掉重建不回來,所以要進版控。
# 要放測試資料請用 python app.py --setups-dir <暫存目錄>,不要往 setups/ 丟。
