# ─────────────────────────────────────────────────────────
# 這一台機器的事實。複製成 .env 再改。
#
# 只放「換一台機器就要改」的東西。行為設定(哪些視窗自動關、
# 哪些測項需人工、逾時多久)留在 config.json —— 那些每台機器都一樣。
#
# 優先權:真正的環境變數 > .env > config.json
# 沒有 .env 也能跑,那就完全照 config.json。
# ─────────────────────────────────────────────────────────

# ── 後端 ──
# com = 真的接 ACQUA ・ mock = 不接,只看流程
ACQUA_BACKEND=com

# ── SQL Server ──
# 格式是「機器名\實例名」,實例名通常是 ACQUADBSERVER。
# 不確定機器名的話,啟動後按網頁左欄的「掃描」會列出來。
ACQUA_DB_SERVER=YOUR_MACHINE\ACQUADBSERVER
ACQUA_DB_NAME=YOUR_DATABASE

# Windows 驗證(1)通常就夠。要用 SQL 帳號才填下面兩行。
ACQUA_DB_WINDOWS_AUTH=1
ACQUA_DB_USER=
ACQUA_DB_PASSWORD=

# ── 網頁 ──
# 只綁 127.0.0.1 = 只有本機連得到。要讓同網段的人連就改 0.0.0.0,
# 但這個服務沒有任何身分驗證,對外開放前請想清楚。
ACQUA_WEB_HOST=127.0.0.1
ACQUA_WEB_PORT=5000

# ── 報告 ──
# ACQUA 產生報告的暫存資料夾(相對於專案根目錄)。
# 最終要存去哪是在網頁上決定的,這裡只是中繼站。
ACQUA_REPORT_DIR=reports

# ── 治具控制器(尚未實作)──
# 序列中間的「移動治具」目前是模擬五秒。之後會發 HTTP 到這個位址,
# 例如 http://192.168.1.50:8000
ACQUA_SETUP_CONTROLLER=
